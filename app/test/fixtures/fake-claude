#!/bin/sh
# Stand-in for the real claude binary. Behaviour is switched by env vars so a
# single fixture covers every case the runner must handle.
if [ -n "$FAKE_CLAUDE_ARGV_FILE" ]; then
  : > "$FAKE_CLAUDE_ARGV_FILE"
  for a in "$@"; do printf '%s\n' "$a" >> "$FAKE_CLAUDE_ARGV_FILE"; done
fi

case "${FAKE_CLAUDE_MODE:-success}" in
  success)
    printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"Hello from Claude","session_id":"sess-1","duration_ms":123,"total_cost_usd":0.004}'
    exit 0 ;;
  error_result)
    printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"I cannot see that entity","session_id":"sess-1","duration_ms":50,"total_cost_usd":0.001}'
    exit 0 ;;
  resume_missing)
    echo "No conversation found with session ID: sess-1" >&2
    exit 1 ;;
  session_in_use)
    echo "Error: Session ID sess-1 is already in use." >&2
    exit 1 ;;
  budget_exhausted)
    # Verified against claude 2.1.261: exit 1, stderr EMPTY, and a complete
    # result envelope on stdout whose `result` is null.
    printf '%s\n' '{"type":"result","subtype":"error_max_budget_usd","is_error":true,"result":null,"session_id":"sess-1","duration_ms":2100,"total_cost_usd":0.5}'
    exit 1 ;;
  unrecognized_model)
    # Verified against claude 2.1.261: exit 1, a valid envelope on stdout AND
    # a one-line diagnostic on stderr that matches neither session-recovery
    # regex.
    printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"Unrecognized model: bogus-model-xyz","session_id":"sess-1","duration_ms":30,"total_cost_usd":0}'
    echo '[claude-code:unrecognized_model] {"model":"bogus-model-xyz"}' >&2
    exit 1 ;;
  root_guard)
    # Reproduces claude 2.1.261 refusing --permission-mode bypassPermissions
    # under root: the add-on container is uid 0, so every Assist turn hit this
    # and died before reaching Home Assistant. Succeeds only when the runner
    # declares the sandbox, which is what makes the paired test meaningful.
    if [ "$IS_SANDBOX" = "1" ]; then
      printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"Hello from Claude","session_id":"sess-1","duration_ms":123,"total_cost_usd":0.004}'
      exit 0
    fi
    echo "--dangerously-skip-permissions cannot be used with root/sudo privileges for security reasons" >&2
    exit 1 ;;
  hard_fail)
    # Non-zero exit with nothing usable on stdout: still an error.
    echo "something went very wrong" >&2
    exit 1 ;;
  garbage)
    printf '%s\n' 'not json at all'
    exit 0 ;;
  hang)
    # Record our own pid, then background a real grandchild (a second
    # process, forked by this shell) and record its pid too. This lets a
    # test prove the runner's timeout kill reaches the whole process group
    # -- not just this direct child -- by checking both pids are gone after.
    if [ -n "$FAKE_CLAUDE_PID_FILE" ]; then
      printf '%s\n' "$$" > "$FAKE_CLAUDE_PID_FILE"
    fi
    sleep 300 &
    child_pid=$!
    if [ -n "$FAKE_CLAUDE_CHILD_PID_FILE" ]; then
      printf '%s\n' "$child_pid" > "$FAKE_CLAUDE_CHILD_PID_FILE"
    fi
    wait "$child_pid" ;;
esac
